# Endpaper configuration. Copy to `.env` and edit.
#
# Everything here has a working default except SECRET_KEY, so a first run needs
# one line. The rest are blocks that stay inert until the setting above them
# turns them on: skip a block whose toggle you are not using.
#
# Where the detail lives, so it is in one place rather than thirty:
#
#   docs/security.md   what each secret reaches, and what it cannot
#   DOCKERHUB.md       running the image, volumes, the reverse proxy
#   the Settings screen changes that take effect without a restart. Anything
#                      configurable there can also be pinned here, and a pinned
#                      value wins: the screen shows it and refuses the edit.

# ── Core ─────────────────────────────────────────────────────────────────────
# The only required line. Sessions are signed with it, so changing it signs
# everybody out.
SECRET_KEY=replace-with-at-least-32-random-characters

DATABASE_URL=sqlite:///./data/library.db
DATA_DIR=./data
APP_ENV=production
SERVE_FRONTEND=true
CORS_ORIGINS=
ALLOW_REGISTRATION=true
ENABLE_OVERDUE_TICKER=true

# ── Sign in ──────────────────────────────────────────────────────────────────
# `local` keeps accounts and passwords here. `ldap` checks them against a
# directory and disables signup. `proxy` trusts an upstream that has already
# authenticated the request. The block for the mode you are not using is
# ignored entirely.
AUTH_MODE=local

# ── LDAP, read only when AUTH_MODE=ldap ──────────────────────────────────────
LDAP_URL=
LDAP_START_TLS=true
LDAP_BIND_DN=
LDAP_BIND_PASSWORD=replace-with-the-service-account-password
LDAP_USER_BASE_DN=
LDAP_USER_FILTER=
LDAP_USERNAME_ATTRIBUTE=uid
LDAP_ADMIN_GROUP=
# Which attribute carries a member's mail address, usually `mail`. Empty means
# the directory has none, and empty is not the same as "nobody has an address":
# set it and the directory owns the value, re-applies it on every sign in and
# the field goes read only in the app. Leave it empty and members keep their own.
#
# SETTING THIS CLEARS ADDRESSES THE DIRECTORY DOES NOT CARRY. A member whose
# entry has no such attribute has their stored address emptied at their next
# sign in, and the field is read only from that moment, so nobody can put it
# back. That is the same rule LDAP_ADMIN_GROUP applies to admin rights, without
# the safety net: a wrong demotion is fixed by adding the member to the group,
# and a cleared address is gone. Populate the attribute in the directory first.
LDAP_EMAIL_ATTRIBUTE=

# ── Proxy, read only when AUTH_MODE=proxy ────────────────────────────────────
# Only set these behind a proxy that strips them from client requests. A header
# nobody strips is a login form with no password.
PROXY_USER_HEADER=Remote-User
PROXY_GROUPS_HEADER=Remote-Groups
PROXY_ADMIN_GROUP=
# The header asserting a member's address, `Remote-Email` for Authelia. Empty
# means the upstream sends none. Same ownership rule and the same warning as
# LDAP_EMAIL_ATTRIBUTE: setting this clears the stored address of any member the
# upstream does not send one for, and the field is read only afterwards.
PROXY_EMAIL_HEADER=

# ── Overdue reminders by mail, inert unless the mail sender is switched on ────
# Settable on the Settings screen instead. Pin them here and the screen shows
# them as fixed.
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=replace-with-the-mailbox-password
MAIL_DEFAULT_SENDER=

# ── Overdue reminders by Telegram, inert unless that sender is switched on ────
# The token is a path segment in every request, so anything logging a URL logs
# the token. Treat it as a password.
TELEGRAM_BOT_TOKEN=replace-with-the-bot-token-from-botfather
TELEGRAM_CHAT_ID=

# ── Catalogue lookups ────────────────────────────────────────────────────────
# Optional. Without it Google Books is not asked; the other catalogues need no
# credential.
GOOGLE_BOOKS_API_KEY=
