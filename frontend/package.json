{
  "name": "endpaper",
  "private": true,
  "license": "MIT",
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check:build": "bun run scripts/check-build.ts",
    "api:schema": "uv --directory ../backend run python scripts/dump_openapi.py > openapi.json",
    "api:generate": "bun run api:schema && bun run api:client",
    "api:client": "orval",
    "format": "oxfmt --write src tests",
    "format:check": "oxfmt --check src tests",
    "lint": "oxlint src tests",
    "lint:fix": "oxlint src tests --fix"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.101.4",
    "@zxing/library": "^0.23.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "sql.js": "^1.15.1"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "1.1.3",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "ajv": "8.20.0",
    "fast-check": "4.10.2",
    "happy-dom": "21.0.3",
    "jsdom": "30.1.3",
    "orval": "8.43.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.88.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  },
  "overrides": {
    "rolldown": "1.2.15"
  }
}
