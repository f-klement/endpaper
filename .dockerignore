# Python bytecode and tool caches
**/__pycache__
**/*.pyc
**/.pytest_cache
**/.ruff_cache
**/.mypy_cache
**/.coverage
**/htmlcov

# Runtime data: the database and uploaded covers belong in a mounted volume
backend/data/
data/

# The React Native client. It never reaches the image regardless, because the
# Dockerfile copies frontend/ and backend/ by name rather than the whole tree.
# Excluded here so it is not shipped to the daemon as build context either: a
# node_modules tree for a native project is large and none of it is read.
#
# `shared/` is deliberately NOT excluded. Once frontend/ imports from it the
# bundle needs it, and its absence would fail at the build step rather than here.
mobile/

# Installed dependencies and build output; both stages build these themselves
frontend/node_modules/
frontend/dist/
frontend/coverage/
backend/.venv/

# Test suites: published as source, but of no use inside the runtime image
backend/tests/
frontend/tests/

# Repository and release machinery
.git
.gitignore
.github
.gitlab-ci.yml
ci/
docs/
CLAUDE.md
# The stripped tree that ci/make-public-tree.sh materialises at the repo root.
# Unanchored and without **, this matches only ./public. frontend/public/,
# which holds the PWA icons and manifest, is untouched and still built in.
./public/

# Secrets, never in the build context
.env
*.pem
*.key
